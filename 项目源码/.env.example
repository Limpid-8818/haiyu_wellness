# 本文件是示例，不会自动加载；复制为 项目源码/.env 后，npm start / npm run dev 的 API 进程会读取。
PORT=3020
DB_DRIVER=sqlite
# Vite 开发服务器设置；API_PROXY_TARGET 应指向 PORT 对应的 API。
WEB_PORT=5180
API_PROXY_TARGET=http://localhost:3020
# 相对路径按 server workspace 工作目录解析，即 项目源码/server。
# 此值与 db.js 默认数据库位置一致。
DB_PATH=./data/community-v2.sqlite

# 上线前必须替换为随机强密钥，不能使用源码默认值。
AUTH_SECRET=replace-with-a-random-32-byte-secret

# 兼容 OpenAI Chat Completions 的模型服务；更换服务商时修改这三个 LLM_* 值。
# LLM_BASE_URL 与 LLM_API_KEY 同时有效时才尝试模型请求；否则使用安全引导模式。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 可选，毫秒。默认 20000；只接受正数，最大按 120000 计算。
LLM_TIMEOUT_MS=60000
# 可选，毫秒。默认 28800000（8 小时）；只接受正数，最大按 604800000（7 天）计算。
ASSISTANT_SESSION_TTL_MS=28800000

# 当前本地协作预算；四领域共享这些上限，不是每个智能体各自独享。
# 8192 Token 与第56轮较大预算不同；完整四领域日常复测仍待完成，见待修复BUG列表 R01。
ASSISTANT_MAX_MODEL_CALLS=50
ASSISTANT_MAX_TOKENS=8192
ASSISTANT_MAX_TOOL_CALLS=12
ASSISTANT_MAX_TOOL_ROUNDS=4
ASSISTANT_MAX_RUNTIME_MS=90000
ASSISTANT_TOOL_TIMEOUT_MS=15000
ASSISTANT_MAX_ESTIMATED_COST_USD=0.10

# 大连开发区真实公开环境来源，不需要另申请 Open-Meteo Key。
# 地区代表点，不是机构精确地址；模式海面高度不是官方台站潮位或机构开放批准。
ENVIRONMENT_MODE=live
ENVIRONMENT_LIVE=1
ENVIRONMENT_TIDE_PROVIDER=open-meteo
ENVIRONMENT_LOCATION_ID=dalian-etdz-region-representative
ENVIRONMENT_LOCATION_NAME=大连经济技术开发区地区代表点（非机构精确地址）
ENVIRONMENT_LATITUDE=39.052585
ENVIRONMENT_LONGITUDE=121.787513
ENVIRONMENT_TIME_ZONE=Asia/Shanghai
ENVIRONMENT_COORDINATES_STATUS=region-representative
ENVIRONMENT_INSTITUTION_LOCATION_CONFIGURED=0
ENVIRONMENT_LOCATION_SOURCE="https://www.wikidata.org/wiki/Q1000487#P625"
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine
