# 本文件是示例，不会被源码自动加载；将所需变量显式导出到 shell/进程管理器。
PORT=3020
# Vite 开发服务器设置；API_PROXY_TARGET 应指向 PORT 对应的 API。
WEB_PORT=5180
API_PROXY_TARGET=http://localhost:3020
# 相对路径按 server workspace 工作目录解析，即 项目源码/server。
# 此值与 db.js 默认数据库位置一致。
DB_PATH=./data/community-v2.sqlite

# 上线前必须替换为随机强密钥，不能使用源码默认值。
AUTH_SECRET=replace-with-a-random-32-byte-secret

# LLM_BASE_URL 与 LLM_API_KEY 同时有效时尝试 OpenAI-compatible API；否则使用安全引导模式。
LLM_BASE_URL=
LLM_API_KEY=replace-with-your-compatible-api-key
LLM_MODEL=gpt-4o-mini

# 可选，毫秒。默认 20000；只接受正数，最大按 120000 计算。
LLM_TIMEOUT_MS=20000
# 可选，毫秒。默认 28800000（8 小时）；只接受正数，最大按 604800000（7 天）计算。
ASSISTANT_SESSION_TTL_MS=28800000
