# 本文件是示例，不会自动加载；复制为 项目源码/.env 后，npm start / npm run dev 的 API 进程会读取。
PORT=3020
DB_DRIVER=sqlite
# Vite 开发服务器设置；API_PROXY_TARGET 应指向 PORT 对应的 API。
WEB_PORT=5180
API_PROXY_TARGET=http://localhost:3020
# 相对路径按 server workspace 工作目录解析，即 项目源码/server。
# 此值与 db.js 默认数据库位置一致。
DB_PATH=./data/community-v2.sqlite

# 上线前必须替换为随机强密钥，不能使用源码默认值。
AUTH_SECRET=replace-with-a-random-32-byte-secret

# 单进程请求限制：每个窗口允许的 HTTP 请求数，错误/重复请求也计数；重启后计数重置。
# 仅使用 socket 对端 IP，忽略客户端转发头；反向代理后所有请求会共享代理 IP 桶。
# 所有值须为正整数，非法配置拒绝启动。窗口最大 86400000ms，计数/桶容量最大 100000。
# 身份桶：LOGIN=规范化账号，REGISTER=手机号，ASSISTANT/PASSWORD=已认证用户 ID。
# PASSWORD 由改密和员工创建共享；匿名助手只有 IP 桶。模型内部调用不另计 HTTP 次数。
REQUEST_LIMIT_MAX_BUCKETS=10000
REQUEST_LIMIT_LOGIN_WINDOW_MS=900000
REQUEST_LIMIT_LOGIN_IP=60
REQUEST_LIMIT_LOGIN_IDENTITY=15
REQUEST_LIMIT_REGISTER_WINDOW_MS=3600000
REQUEST_LIMIT_REGISTER_IP=20
REQUEST_LIMIT_REGISTER_IDENTITY=5
REQUEST_LIMIT_ASSISTANT_WINDOW_MS=60000
REQUEST_LIMIT_ASSISTANT_IP=120
REQUEST_LIMIT_ASSISTANT_IDENTITY=60
REQUEST_LIMIT_PASSWORD_WINDOW_MS=900000
REQUEST_LIMIT_PASSWORD_IP=60
REQUEST_LIMIT_PASSWORD_IDENTITY=20

# 兼容 OpenAI Chat Completions 的模型服务；更换服务商时修改这三个 LLM_* 值。
# LLM_BASE_URL 与 LLM_API_KEY 同时有效时才尝试模型请求；否则使用安全引导模式。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 可选，毫秒。默认 20000；只接受正数，最大按 120000 计算。
LLM_TIMEOUT_MS=60000
# 可选，毫秒。默认 28800000（8 小时）；只接受正数，最大按 604800000（7 天）计算。
ASSISTANT_SESSION_TTL_MS=28800000

# 当前本地协作预算；四领域共享这些上限，不是每个智能体各自独享。
# 阶段3A实测8192不足以完成四领域和协调器；公开默认统一16384，保留预算拒绝与实报usage。
ASSISTANT_MAX_MODEL_CALLS=50
ASSISTANT_MAX_TOKENS=16384
ASSISTANT_MAX_TOOL_CALLS=12
ASSISTANT_MAX_TOOL_ROUNDS=4
ASSISTANT_MAX_RUNTIME_MS=90000
ASSISTANT_TOOL_TIMEOUT_MS=15000
ASSISTANT_MAX_ESTIMATED_COST_USD=0.10

# 大连开发区真实公开环境来源，不需要另申请 Open-Meteo Key。
# 地区代表点，不是机构精确地址；模式海面高度不是官方台站潮位或机构开放批准。
ENVIRONMENT_MODE=live
ENVIRONMENT_LIVE=1
ENVIRONMENT_TIDE_PROVIDER=open-meteo
ENVIRONMENT_LOCATION_ID=dalian-etdz-region-representative
ENVIRONMENT_LOCATION_NAME=大连经济技术开发区地区代表点（非机构精确地址）
ENVIRONMENT_LATITUDE=39.052585
ENVIRONMENT_LONGITUDE=121.787513
ENVIRONMENT_TIME_ZONE=Asia/Shanghai
ENVIRONMENT_COORDINATES_STATUS=region-representative
ENVIRONMENT_INSTITUTION_LOCATION_CONFIGURED=0
ENVIRONMENT_LOCATION_SOURCE="https://www.wikidata.org/wiki/Q1000487#P625"
OPEN_METEO_WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_MARINE_BASE_URL=https://marine-api.open-meteo.com/v1/marine

# 精确http/https来源，逗号分隔、无路径/尾斜线/通配符（G10/G12）。
# 同时用于cookie写入的Origin校验：配置网页来源（Vite 5180），不要误填API 3020。
# 网页经同源 /api 代理发送HttpOnly、host-only、SameSite=Lax、8小时cookie。
# NODE_ENV=production时cookie自动Secure，部署须HTTPS；开发HTTP无需Secure。
# 网页写入还要求 X-Community-Request: 1；登录/注册以 X-Session-Transport: cookie 选择cookie且body不返回token。
# 默认/显式bearer传输保留API token响应；显式Authorization优先，错误时不回退cookie。
# Defaults to http://127.0.0.1:5180,http://localhost:5180 when unset.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
